{
  "vault_path": "",
  "note_subdir": "学习/视频笔记",
  "asr_backend": "auto",
  "model": "mlx-community/whisper-large-v3-mlx",
  "faster_model": "large-v3",
  "faster_device": "auto",
  "faster_compute_type": "auto",
  "faster_vad_filter": true,
  "language": "zh",
  "word_timestamps": false,
  "include_timestamps": true,
  "note_mode": "auto",
  "pypi_index": "https://pypi.tuna.tsinghua.edu.cn/simple",
  "hf_endpoint": "https://hf-mirror.com",
  "browser_channel": "auto",
  "headless": true,
  "proxy_url": "",
  "keep_temp_on_failure": true,
  "work_root": "",
  "max_duration_minutes": 0,
  "download_timeout_seconds": 120,
  "transcription_estimate_factor": 3.0,
  "_notes": {
    "vault_path": "留空用平台默认 <用户目录>/Desktop/Note；也可用 --vault 临时覆盖",
    "work_root": "留空按平台选择：Windows %LOCALAPPDATA%\\douyin-learning-note\\sessions；macOS ~/Library/Caches/douyin-learning-note/sessions；Linux ~/.cache/douyin-learning-note/sessions",
    "asr_backend": "auto | mlx | faster；auto 表示 macOS 用 mlx-whisper，Windows/Linux 用 faster-whisper",
    "model": "asr_backend=mlx 时的 mlx 仓库",
    "faster_model": "asr_backend=faster 时的模型，可用 large-v3 / medium / small 或完整 HF 仓库名",
    "faster_device": "auto | cpu | cuda",
    "faster_compute_type": "auto | int8 | int8_float16 | float16 | float32",
    "browser_channel": "auto | chrome | msedge | chromium（自带内核，需先 playwright install chromium）或浏览器可执行文件绝对路径"
  }
}
